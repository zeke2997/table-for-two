{
  "name": "table-for-two",
  "version": "1.0.0",
  "private": true,
  "description": "两人自用的电子菜单：主厨记菜谱，另一半在线点单",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "db:migrate:local": "wrangler d1 migrations apply table-for-two --local",
    "db:migrate:remote": "wrangler d1 migrations apply table-for-two --remote",
    "test": "node --test \"tests/*.test.js\"",
    "test:api": "node --test tests/api.e2e.js"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
