{
  "name": "table-for-two",
  "version": "1.0.0",
  "private": true,
  "description": "为情侣两人居家做饭设计的点菜与菜谱网页应用，支持 AI 生成菜谱",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeke2997/table-for-two.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "db:migrate:local": "wrangler d1 migrations apply table-for-two --local",
    "db:migrate:remote": "wrangler d1 migrations apply table-for-two --remote",
    "test": "node --test \"tests/*.test.js\"",
    "test:api": "node --test tests/api.e2e.js"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
